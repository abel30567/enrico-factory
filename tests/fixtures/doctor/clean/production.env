# Invented settings for the doctor tests. The tests write production.local.env with
# PY, SECRETS_DIR and DATA_DIR, which are machine-specific.

MODE="fast"
EXTRA=on
SECRETS_DIR=placeholder-overridden-by-the-local-file
CAP_EPISODE_USD=10
CAP_SEASON_USD=100
CAP_EPISODE_COMPUTE_MIN=600
CAP_SEASON_COMPUTE_MIN=6000
CAP_TICKET_ITERATIONS=5
CAP_EPISODE_HOURS=168
CAP_SEASON_HOURS=2000
